# ---------- Backend (FastAPI) ----------
# Elexon Insights API base URL (public, no key required)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Per-request timeout (seconds), retry count and initial backoff (seconds, doubles per retry)
HTTP_TIMEOUT_S=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_S=1.0
# Size of each request window when downloading (days)
FETCH_CHUNK_DAYS=7
# Where the normalised dataset is cached on disk
CACHE_DIR=./.cache
# Hours before the disk cache is considered stale. 0 = never (January 2026 is historical)
CACHE_TTL_HOURS=0
# live = Elexon API, fixture = bundled DEMO FIXTURE (offline development only)
DATA_MODE=live
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Default decision cutoff policy: D-<offset> at HH:MM Europe/London (pilot assumption, not a market rule)
DEFAULT_CUTOFF_DAY_OFFSET=1
DEFAULT_CUTOFF_TIME=09:00
# Download data in the background at startup instead of on the first request
WARM_ON_STARTUP=false
# Enables POST /api/admin/refresh when set (send as X-Admin-Token header). Leave empty to disable.
ADMIN_TOKEN=

# ---------- Frontend (Vite) ----------
# Base URL of the backend as seen from the browser
VITE_API_BASE_URL=http://localhost:8000

# ---------- Docker Compose ----------
# Host ports (5173 is often taken by other dev servers)
FRONTEND_PORT=8080
BACKEND_PORT=8000
